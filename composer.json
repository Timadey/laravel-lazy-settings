{
    "name": "timadey/laravel-lazy-settings",
    "description": "Enum-driven, per-scope settings for Laravel with lazy persistence: definitions live in an enum, values are only stored when changed, reads fall back to declared defaults.",
    "version": "0.1.2",
    "keywords": ["laravel", "settings", "config", "enums", "scoped", "lazy"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Timadey"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/cache": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/encryption": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Timadey\\LazySettings\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Timadey\\LazySettings\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Timadey\\LazySettings\\SettingsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
